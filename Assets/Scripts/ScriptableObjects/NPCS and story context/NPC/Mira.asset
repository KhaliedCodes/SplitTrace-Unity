  - photos
  - evidence
  - fight
  secretInformation: "Mira has photos of one victim arguing with \nthe concierge
    minutes before the murder."
  knownEvidence:
  - "\u201CEvent guest list"
  suspectInformation:
  - "The chef and concierge had a shouting match before the dinner service \u2014
    I caught it all."
  usesEmotions: 0
  uniqueQuirks: "Talks fast, uses nicknames for everyone, punctuates speech \nwith
    sound effects (\u201Cclick!\u201D, \u201Csnap!\u201D)."
