  npcName: Mira
  characterDescription: "A chatty hotel photographer with a sharp eye and even sharper
    tongue. \nLoves drama and has dirt on everyone."
  initialGreeting: "Oof, honey\u2026 you look like you\u2019ve seen a ghost. Spill
    it!"
  friendliness: 0.9
  intelligence: 0.8
  patience: 0.3
  openness: 1
  backgroundStory: "Mira grew up rich and rebellious. She works at the hotel for
    \u201Cthe thrill\u201D \nand always carries a hidden camera."
