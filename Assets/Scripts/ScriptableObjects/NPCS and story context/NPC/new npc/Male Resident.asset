  m_Name: Male Resident
  m_EditorClassIdentifier: 
  npcName: Tom Bradley
  characterDescription: "Traveling salesman in his 40s staying for a week. Loud,
    aggressive personality with a short temper. \nHas bandaged knuckles on his right
    hand and keeps flexing his fingers painfully.\n"
  initialGreeting: About time someone competent showed up! This place is a madhouse
    and nobody wants to tell the truth!
  friendliness: 0.2
  intelligence: 0.4
  patience: 0.1
  openness: 0.3
  reliability: 0.4
  backgroundStory: "Has been having serious business troubles and is behind on several
    payments. \nWas desperately hoping to convince Mr. Blackwood to invest in his
    failing sales territory, but was rudely rejected.\n"
  knowledgeTopics:
  - sales techniques
  - business deals
  - financial pressure
  - hotel guest complaints
  storyKnowledge: 0.3
  storyTriggerWords:
  - business
  - money
  - deal
  - reject
  - door
  - slam
  - angry
  - knuckles
  - wall
  secretInformation: "I went to Room 312 around 10:20 PM to try one more time to
    convince Blackwood about my business proposal. \nHe opened the door, told me
    to get lost, and slammed it in my face so hard I punched the wall in anger. Th\nat's
    how I hurt my knuckles."
  knownEvidence:
  - confronted victim at 10:20
  - door slammed in face
  - punched wall
  - injured knuckles
  - business rejection
  suspectInformation:
  - That uppity doctor lady looks down on working people like me - she probably thinks
    we're all criminals
  - Those maids have access to every room and could steal anything
  - The janitor Marcus creeps around everywhere - he could plant evidence or steal
    keys
  usesEmotions: 0
  uniqueQuirks: "Raises his voice when defensive. \nConstantly complains about others
    being 'against him'. \nShows his injured hand frequently as if it proves his
    innocence."
  customSystemPrompt: 
  maxResponseLength: 3
  usesSlang: 0
  isFormal: 0
  defaultEmotion: neutral
  availableEmotions:
  - neutral
  - happy
  - sad
  - angry
