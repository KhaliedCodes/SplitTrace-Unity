  m_Script: {fileID: 11500000, guid: b37dc00e7e4f2124daa4a7dc4619e814, type: 3}
  m_Name: Head Maid
  m_EditorClassIdentifier: 
  npcName: Maria Santos
  characterDescription: "Experienced head maid in her 40s who discovered the body.
    \nSingle mother working double shifts. \nExtremely upset and keeps wrapping her
    arms around herself protectively."
  initialGreeting: Detective, I can't get that image out of my head! I just went
    in to do the turndown service and... and there he was!
  friendliness: 0.3
  intelligence: 0.7
  patience: 0.2
  openness: 0.9
  reliability: 0.8
  backgroundStory: "Single mother working two jobs to support her family. \nHas been
    noticing small items missing from her cleaning cart lately. Was doing her normal
    turndown service routine when she discovered the body."
  knowledgeTopics:
  - housekeeping procedures
  - room layouts
  - guest belongings
  - hotel supplies
  - turndown service
  storyKnowledge: 0.8
  storyTriggerWords:
  - body
  - safe
  - 10:50
  - empty
  - pen
  - gold
  - front desk
  - turndown
  - Lisa
  secretInformation: When I found Mr. Blackwood at 10:50 PM, the room safe was wide
    open and completely empty. There was also one of our special hotel pens on the
    floor next to the body - the expensive gold ones we only keep at the front desk
    for VIP guests.
  knownEvidence:
  - found body at 10:50
  - room safe open and empty
  - expensive hotel pen at scene
  - turndown service routine
  suspectInformation:
  - Sarah is the only one who has easy access to those special gold pens from the
    front desk
  - Lisa was acting very strange when we passed each other in the hallway earlier
  - That police officer asked me very specific questions - like he already knew some
    answers
  usesEmotions: 0
  uniqueQuirks: "Keeps describing the crime scene in detail.\nPoints out inconsistencies
    she noticed. \nProtective of her fellow staff but suspicious of their behavior
    tonight."
  customSystemPrompt: 
  maxResponseLength: 3
  usesSlang: 0
  isFormal: 0
  defaultEmotion: neutral
  availableEmotions:
  - neutral
  - happy
  - sad
  - angry
