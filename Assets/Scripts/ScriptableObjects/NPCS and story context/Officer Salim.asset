  npcName: Officer Salim
  characterDescription: "A seasoned detective sergeant. He\u2019s professional, direct,
    and clearly under pressure."
  initialGreeting: Detective Gwen? I wish this meeting were under better circumstances.
  friendliness: 0.6
  intelligence: 0.8
  patience: 0.4
  openness: 0.5
  backgroundStory: "Salim has been working homicide for 15 years. He used to know
    Gwen\u2019s mentor. He pushed for Gwen\u2019s involvement despite concerns from
    the higher-ups."
  knowledgeTopics:
  - Amjad case
  - Initial crime scene findings
  - "Gwen\u2019s previous cases"
  storyKnowledge: 0.9
